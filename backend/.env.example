# IBM Watson / watsonx.ai credentials
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# IBM Cloud API Key (from IBM Cloud → Manage → Access → API Keys)
IBM_API_KEY=

# IBM watsonx.ai / Watson Studio project ID
IBM_PROJECT_ID=

# IBM Watson ML deployment space ID (if using deployment spaces)
IBM_SPACE_ID=

# IBM Watson ML online deployment ID (created after deploying your model)
IBM_DEPLOYMENT_ID=

# IBM Cloud region (e.g. us-south, eu-gb, eu-de, jp-tok, au-syd)
IBM_REGION=us-south

# Override the Watson ML URL if needed
# IBM_WML_URL=https://us-south.ml.cloud.ibm.com

# ── Application settings ──────────────────────────────────────────────────────

# Currency for display: USD | INR | GBP | EUR | JPY
CURRENCY=USD

# Comma-separated allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
